
SENTINEL_SEC_USER_AGENT="<YOUR NAME> <EMAIL>"
SENTINEL_DATA_DIR=data
SENTINEL_QDRANT_URL=http://localhost:6333
SENTINEL_POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5431/sentinel

# Chunking
SENTINEL_CHUNKER=recursive
SENTINEL_CHUNK_SIZE=1000
SENTINEL_CHUNK_OVERLAP=200
SENTINEL_SEMANTIC_PERCENTILE=90.0
SENTINEL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SENTINEL_EMBEDDING_BATCH_SIZE=64

# Qdrant Collection
SENTINEL_QDRANT_COLLECTION=filings
SENTINEL_BM25_AVG_LEN=160
SENTINEL_HYBRID_CANDIDATES=50
SENTINEL_RERANKER_MODEL=BAAI/bge-reranker-base
SENTINEL_RERANKER_CANDIDATES=20

# Hybrid retrieval and reranking
SENTINEL_BM25_AVG_LEN=160
SENTINEL_HYBRID_CANDIDATES=50
SENTINEL_RERANKER_MODEL=BAAI/bge-reranker-base
SENTINEL_RERANKER_CANDIDATES=20

# Generation 
SENTINEL_GENERATOR=local         # local | api
SENTINEL_GENERATOR_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SENTINEL_GENERATOR_CONTEXT=4096
SENTINEL_GENERATOR_MAX_NEW_TOKENS=512
SENTINEL_GENERATOR_TEMPERATURE=0.0
# This for cloud
SENTINEL_GENERATOR_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SENTINEL_GENERATOR_API_MODEL=gemini-3.8-flash
SENTINEL_GENERATOR_API_KEY=
