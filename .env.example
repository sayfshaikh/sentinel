
SENTINEL_SEC_USER_AGENT="<YOUR NAME> <EMAIL>"
SENTINEL_DATA_DIR=data
SENTINEL_QDRANT_URL=http://localhost:6333
SENTINEL_POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5431/sentinel

# Chunking
SENTINEL_CHUNKER=recursive
SENTINEL_CHUNK_SIZE=1000
SENTINEL_CHUNK_OVERLAP=200
SENTINEL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SENTINEL_EMBEDDING_BATCH_SIZE=64